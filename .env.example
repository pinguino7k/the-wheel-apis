# Copia este archivo como .env y llena los valores (el .env no se sube a GitHub)
# ---------------------------------------------------------------------
# Microservicio
# ---------------------------------------------------------------------
HOST=localhost
PORT=3020
API_URL=/api/v1

# ---------------------------------------------------------------------
# Conexion NoSQL: MongoDB Atlas (BD the_wheel)
# ---------------------------------------------------------------------
CONNECTION_STRING=mongodb+srv://USUARIO:PASSWORD@clusterwheel.xxxxxxx.mongodb.net/
DATABASE=the_wheel

# ---------------------------------------------------------------------
# Conexion SQL: Supabase (Project Settings > API)
# ---------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=llave_secret_o_service_role

# ---------------------------------------------------------------------
# Inicio de sesion (JSON Web Token)
# DB_DEFAULT es la base que se usa si el login no envia dbServer
# ---------------------------------------------------------------------
JWT_SECRET=escribe_una_frase_secreta_larga
JWT_EXPIRES=8h
DB_DEFAULT=MongoDB

# Usuario que se registra en DETAIL_ROW si no se conoce el usuario
DEFAULT_REGUSER=MJGONZALEZ
